alias cd='z'

alias c='clear'
alias mkdir='mkdir -p'
alias ..='cd ..' 
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'
alias vim='nvim'
alias vm='nvim'
alias btw='fastfetch'
alias fonts='fc-list -f "%{family}\n"'
alias untar='tar -xf'

alias config='git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

alias cleartrash="rm -rf ~/.local/share/Trash/*"
