alias cd='z'

alias altman='tldr'
alias c='clear'
alias lg='lazygit'
alias mkdir='mkdir -p'
alias ..='cd ..' 
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'
alias vim='nvim'
alias vm='nvim'
alias btw='fastfetch'
alias fonts='fc-list -f "%{family}\n"'
alias untar='tar -xf'
alias slurp='slurp -w 0'

alias tasks='btop'
alias Docs='nautilus $HOME/Documents'
alias Settings='cd ~/.config/hypr/ && nvim .'

alias config='nvim ~/.config/'

alias cleartrash="rm -rf ~/.local/share/Trash/*"
