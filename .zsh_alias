alias cd='z'
alias zt='zerotier-cli'

alias altman='tldr'
alias c='clear'
alias lg='lazygit'
alias mkdir='mkdir -p'
alias ..='cd ..' 
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'
alias vim='nvim'
alias vm='nvim'
alias btw='fastfetch'
alias fonts='fc-list -f "%{family}\n"'
alias untar='tar -xf'
alias slurp='slurp -w 0'

alias tasks='btop'
alias Docs='nautilus $HOME/Documents'
alias Settings='cd ~/.config/hypr/ && nvim .'

alias config='nvim ~/.config/'

alias cleartrash="rm -rf ~/.local/share/Trash/*"

alias ua-drop-caches='sudo paccache -rk3; yay -Sc --aur --noconfirm'
alias ua-update-all='export TMPFILE="$(mktemp)"; \
    sudo true; \
    rate-mirrors --save=$TMPFILE arch --max-delay=21600 \
      && sudo mv /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-backup \
      && sudo mv $TMPFILE /etc/pacman.d/mirrorlist \
      && ua-drop-caches \
      && yay -Syyu --noconfirm'
alias ua-update-mirrors='export TMPFILE="$(mktemp)"; \
    sudo true; \
    rate-mirrors --save=$TMPFILE arch --max-delay=21600 \
      && sudo mv /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-backup \
      && sudo mv $TMPFILE /etc/pacman.d/mirrorlist'
