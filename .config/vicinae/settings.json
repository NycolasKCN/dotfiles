// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "escape_key_behavior": "",
   "keybinding": "vim",
   "global_shortcuts": {
      "toggle": ""
   },
   "font": {
      "normal": {
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "rounding": 12,
      "opacity": 0.7,
      "compact_mode": {
         "enabled": true
      },
      "layer_shell": {
         "enabled": true
      }
   },
   "providers": {
      "@jomifepe/store.raycast.bitwarden": {
         "preferences": {
            "cliPath": "/usr/bin/bw",
            "fetchFavicons": true,
            "repromptIgnoreDuration": "28800000",
            "serverUrl": "",
            "shouldCacheVaultItems": true,
            "syncOnLaunch": true,
            "windowActionOnCopy": "close"
         },
         "entrypoints": {
            "authenticator": {
               "enabled": false
            },
            "create-folder": {
               "enabled": false
            },
            "search": {
               "alias": "bw"
            }
         }
      },
      "applications": {
         "entrypoints": {
            "ferdium": {
               "alias": "whatsapp"
            }
         }
      },
      "core": {
         "entrypoints": {
            "documentation": {
               "enabled": false
            },
            "keybind-settings": {
               "enabled": false
            },
            "manage-fallback": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false,
         "entrypoints": {
            "create": {
               "enabled": false
            }
         }
      },
      "files": {
         "preferences": {
            "autoIndexing": true,
            "excludedIndexingPaths": [
               "/home/nyc/node_modules"
            ],
            "indexingPaths": [
               "/home/nyc",
               "/home/nyc/shared/obsidianVaults/all-at-once"
            ]
         },
         "entrypoints": {
            "search": {
               "alias": "e"
            }
         }
      },
      "power": {
         "enabled": false
      },
      "snippets": {
         "enabled": false
      },
      "system": {
         "enabled": false,
         "entrypoints": {
            "volume-100": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "entrypoints": {
            "switch-windows": {
               "alias": "w"
            }
         }
      }
   }
}