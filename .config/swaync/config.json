{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",

  "layer": "overlay",

  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 350,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-2fa-action": false,
  "notification-inline-replies": true,
  "notification-window-width": 350,
  "notification-icon-size": 60,
  "notification-body-image-height": 180,
  "notification-body-image-width": 180,

  "timeout": 8,
  "timeout-low": 8,
  "timeout-critical": 8,

  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": ["mpris", "title", "notifications", "buttons-grid"],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification Center!"
    },

    "mpris": {
      "blacklist": ["playerctld", "chromium"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true,
      "image-size": 80,
      "image-radius": 0
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰝟",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰍭",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle"
        },

        {
          "label": "",
          "command": "kitty nmtui"
        },
        {
          "label": "",
          "command": "blueman-manager"
        },
        {
          "label": "󰤄",
          "command": "swaync-client -d",
          "type": "toggle"
        },

        {
          "label": "󰀟",
          "command": "gnome-network-displays"
        },

        {
          "label": "󰈙",
          "command": "kitty --hold -e Docs"
        },
        {
          "label": "",
          "command": "kitty --hold -e Settings"
        },
        {
          "label": "",
          "command": "kitty tasks"
        },
        {
          "label": "",
          "command": "hyprlock"
        },
        {
          "label": "󰗽",
          "command": "hyprctl dispatch exec \"hyprshutdown -t 'Logging out...'\""
        },
        {
          "label": "",
          "command": "hyprctl dispatch exec \"hyprshutdown -t 'Restarting...' --post-cmd 'systemctl reboot'\""
        },
        {
          "label": "",
          "command": "hyprctl dispatch exec \"hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff'\""
        }
      ]
    }
  }
}
