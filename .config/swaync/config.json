{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",

  "layer": "overlay",

  "layer-shell": true,
  "cssPriority": "user",

  "control-center-layer": "top",
  "control-center-width": 350,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,

  "notification-2fa-action": false,
  "notification-inline-replies": true,
  "notification-window-width": 350,
  "notification-icon-size": 40,
  "notification-body-image-height": 120,
  "notification-body-image-width": 120,

  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 16,

  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": ["mpris", "title", "notifications", "buttons-grid"],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification Center!"
    },

    "mpris": {
      "blacklist": ["playerctld", "chromium"],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true,
      "image-size": 80,
      "image-radius": 0
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰝟",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -qE '\[MUTED\]' && echo 'true' || echo 'false'",
          "type": "toggle"
        },
        {
          "label": "󰍭",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -qE '\[MUTED\]' && echo 'true' || echo 'false'",
          "type": "toggle"
        },
        {
          "label": "",
          "command": "blueman-manager"
        },
        {
          "label": "󰤄",
          "command": "swaync-client -d",
          "update-command": "swaync-client -D",
          "type": "toggle"
        },

        {
          "label": "󰀟",
          "command": "gnome-network-displays"
        },
        {
          "label": "",
          "command": "wlogout -b 4"
        }
      ]
    }
  }
}
