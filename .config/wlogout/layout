{
    "label" : "lock",
    "action" : "sleep 0.1 && hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "sleep 0.5 && hyprshutdown -t 'Logging out...'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label": "suspend",
    "action": "killall hyprlock || hyprlock & disown && systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}

