{
    "label" : "lock",
    "action" : "sleep 0.1 && hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "sleep 0.5 & hyprshutdown -t 'Logging out...'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label": "suspend",
    "action": "killall hyprlock || hyprlock & disown && systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}
{
    "label" : "reboot",
    "action" : "sleep 0.5 & hyprshutdown -t 'Rebooting now...' --post-cmd 'systemctl reboot'",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "sleep 0.5 & hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl shutdown'",
    "text" : "Shutdown",
    "keybind" : "s"
}

