{
	"battery": {
	    "bat": "BAT0",
	    "adapted": "ADP0",
	    "interval": 60,
	    "states": {
		"warning": 30,
		"critical": 15
	    },
	    "format": "{icon} {capacity}%",
	    "format-charging": "\udb85\udc0b {capacity}%",
	    "format-icons": ["", "", "", "", ""],
	    "max-length": 25
	}
}
